    <string name="guide_title">Como usar</string>
    <string name="guide_t1">Buscar e explorar</string>
    <string name="guide_b1">Digite um prato ou ingrediente na busca do Início. As categorias são ordenadas pela quantidade de pratos, exibida à direita.</string>
    <string name="guide_t2">Seleção de hoje</string>
    <string name="guide_b2">Deslize os cartões no topo do Início. Cada uma das 10 categorias mostra um prato aleatório que muda a cada 5 minutos, mesmo com o app fechado.</string>
    <string name="guide_t3">Ler uma receita</string>
    <string name="guide_b3">Abra um prato para ver o resumo e a data de atualização, dificuldade e calorias estimadas, ingredientes, utensílios e quantidades reunidos, e os passos.</string>
    <string name="guide_t4">Leitura em voz alta</string>
    <string name="guide_b4">Toque em Ler em voz alta para ouvir a receita. Toque em qualquer passo para começar dali; o passo atual fica destacado.</string>
    <string name="guide_t5">Favoritos</string>
    <string name="guide_b5">Toque no coração de um prato para salvá-lo. Todos os salvos ficam na aba Favoritos.</string>
    <string name="difficulty_value">Dificuldade %1$d/5</string>
    <string name="settings_gemini">Chaves de API do Gemini</string>
    <string name="settings_gemini_desc">Receitas novas e alteradas são traduzidas automaticamente com o Gemini 3.5 Flash-Lite. Cole uma chave por linha; as chaves são usadas em rodízio.</string>
