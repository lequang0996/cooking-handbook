    <string name="guide_title">Hướng dẫn sử dụng</string>
    <string name="guide_t1">Tìm kiếm và duyệt món</string>
    <string name="guide_b1">Gõ tên món hoặc nguyên liệu vào ô tìm kiếm ở Trang chủ. Các chủ đề bên dưới xếp theo số món phổ biến, con số hiển thị ở bên phải.</string>
    <string name="guide_t2">Gợi ý hôm nay</string>
    <string name="guide_b2">Vuốt các thẻ ở đầu Trang chủ. Mỗi chủ đề trong 10 chủ đề hiển thị ngẫu nhiên 1 món, đổi mới sau mỗi 5 phút, kể cả khi đã tắt ứng dụng.</string>
    <string name="guide_t3">Xem công thức</string>
    <string name="guide_b3">Mở một món để xem giới thiệu và ngày cập nhật mới nhất, độ khó và calo ước tính, phần nguyên liệu + dụng cụ + định lượng đã gộp, và các bước thực hiện.</string>
    <string name="guide_t4">Đọc to</string>
    <string name="guide_b4">Nhấn Đọc to để nghe công thức. Chạm vào bất kỳ bước nào để đọc từ bước đó; bước đang đọc được làm nổi bật.</string>
    <string name="guide_t5">Yêu thích</string>
    <string name="guide_b5">Chạm biểu tượng trái tim ở món ăn để lưu. Mọi món đã lưu nằm trong thẻ Yêu thích.</string>
    <string name="difficulty_value">Độ khó %1$d/5</string>
