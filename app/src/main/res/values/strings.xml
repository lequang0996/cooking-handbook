    <string name="guide_title">How to use</string>
    <string name="guide_t1">Search and browse</string>
    <string name="guide_b1">Type a dish or an ingredient in the search bar on Home. The topics below are sorted by how many dishes they hold; the number is shown on the right.</string>
    <string name="guide_t2">Today\'s picks</string>
    <string name="guide_b2">Swipe the cards at the top of Home. Each of the 10 topics shows one random dish that changes every 5 minutes, even while the app is closed.</string>
    <string name="guide_t3">Read a recipe</string>
    <string name="guide_b3">Open a dish to see its summary and last update date, its difficulty and estimated calories, the merged ingredients, tools and quantities, and the cooking steps.</string>
    <string name="guide_t4">Read aloud</string>
    <string name="guide_b4">Press Read aloud to hear the recipe. Tap any step to start from there; the current step is highlighted.</string>
    <string name="guide_t5">Favorites</string>
    <string name="guide_b5">Tap the heart on a dish to save it. All saved dishes are in the Favorites tab.</string>
    <string name="difficulty_value">Difficulty %1$d/5</string>
